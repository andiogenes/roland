+/* ------------------------------------------------------ HR-16 samples --- */
+#if FELUCCA_SMPKITS
+/* One recorded hit per lane (tools/gen_hr16.py): IMA ADPCM from rest (predictor 0, index 0), played once, the codes as
+ * eng_sample.c's (IMA_STEP / IMA_IDX). A sample voice keeps its state in the voice: s[0] the lane (as a synthesized hit),
+ * s[1] step index, s[2] previous and s[3] current output, s[4] the sample | HRV_ON | HRV_END, s[5] predictor, s[6] the
+ * decay envelope (Q15), s[7] the TONE filter; ph[0] the position, ph[1] its fraction (Q16), ph[2] 1 = choked */
+typedef struct { uint32_t off, n, rate; } hr_samp_t;   /* byte offset in HR16_DATA, samples, source rate / 44100 (Q16) */
+static const hr_samp_t HR16_SAMP[HR16_NSAMP] = {HR16_SAMP_INIT};
+#define HRV_ON (1 << 16)
+#define HRV_END (1 << 17)
+#define HRV_IDX 0xFFFF
+/* a kit's treatment (HR16_TREAT, from tools/gen_hr16.py): SLOOP's acoustic kit variations, played over the same samples:
+ * DEEP the pitch down 5 semitones (the kick, notes up to 36) or 2, and a soft low-pass; TIGHT a quick decay; BRIGHT up 2
+ * semitones; DUST down 1 semitone, a harder low-pass and 8 bits */
+enum { TREAT_NONE, TREAT_DEEP, TREAT_TIGHT, TREAT_BRIGHT, TREAT_DUST };
+
+static inline int32_t hr_next(const hr_samp_t *z, voice_t *v)
+{
+    uint32_t pos = v->ph[0], b = HR16_DATA[z->off + (pos >> 1)];
+    uint32_t code = (pos & 1u) ? (b >> 4) : (b & 15u);
+    int32_t step = IMA_STEP[(uint32_t)v->s[1] <= 88u ? v->s[1] : 88], vd = step >> 3;
+    if (code & 4u)
+        vd += step;
+    if (code & 2u)
+        vd += step >> 1;
+    if (code & 1u)
+        vd += step >> 2;
+    v->s[5] = clamp(v->s[5] + ((code & 8u) ? -vd : vd), -32768, 32767);
+    v->s[1] = clamp(v->s[1] + IMA_IDX[code & 7u], 0, 88);
+    v->ph[0] = pos + 1u;
+    return v->s[5];
+}
+
+/* voice v starts the lane's sample of the part's kit (the part's KIT is an HR-16 one) */
+static void hr_start(const track_t *t, voice_t *v, uint32_t lane)
+{
+    uint32_t kit = (uint32_t)(t->p[P_E0] - DK_HR) % HR16_NKITS, si = HR16_KIT[kit][lane & (NLANE - 1u)] % HR16_NSAMP;
+    const hr_samp_t *z = &HR16_SAMP[si];
+    v->s[1] = v->s[2] = v->s[3] = v->s[5] = v->s[7] = 0;
+    v->s[6] = 32767;
+    v->ph[0] = v->ph[1] = v->ph[2] = 0;
+    v->s[4] = (int32_t)(si | HRV_ON);
+    if (!z->n)
+        v->s[4] |= HRV_END;
+    else
+        v->s[3] = hr_next(z, v);                         /* prime the interpolator */
+}
+
+/* a closed hat chokes the open one's sample (a short fade, hr_run) */
+static void hr_choke(track_t *t, const drum_lane_t *K)
+{
+    uint32_t o = K[DV_HATO].owner;
+    voice_t *w;
+    if (!o || o > NVOICE)
+        return;
+    w = &t->v[o - 1u];
+    if (w->active && (w->s[4] & HRV_ON))
+        w->ph[2] = 1;
+}
+
+/* n samples of voice v's hit into y (stereo-free, Q15 like dv_run's): resampled to the output rate by TUNE and the note's
+ * offset st (semitones), then DECY (a quicker fade), TONE (a one-pole low-pass), both from 64 down only */
+static void hr_run(const track_t *t, voice_t *v, int32_t st, int32_t *y, uint32_t n)
+{
+    const int16_t *p = t->p;
+    const hr_samp_t *z = &HR16_SAMP[((uint32_t)v->s[4] & HRV_IDX) % HR16_NSAMP];
+    uint32_t tr = HR16_TREAT[(uint32_t)(p[P_E0] - DK_HR) % HR16_NKITS];
+    int32_t sh = tr == TREAT_DEEP ? (v->note <= 36u ? -5 : -2) : tr == TREAT_BRIGHT ? 2 : tr == TREAT_DUST ? -1 : 0;
+    int32_t d16 = clamp((st + sh) * 16 + (p[P_E1] - 64) * 3, -1536, 576);
+    uint32_t r = pow2_q16(d16), stepq = (r >> 8) * (z->rate >> 8), frac = v->ph[1], i = 0;
+    int32_t dec = clamp(p[P_E3], 0, 127), tone = clamp(p[P_E2], 0, 127), env = v->s[6], lp = 32767, dc = 32768;
+    if (dec < 64) {                                      /* e^-6.9 (-60 dB) over 1300 + 22 dec^2 samples */
+        int32_t nn = 1300 + dec * dec * 22;
+        dc = 32768 - 226099 / nn;
+    }
+    if (v->ph[2] && dc > 30508)                          /* choked: -60 dB in about 100 samples */
+        dc = 30508;
+    if (tone < 64)
+        lp = 3000 + tone * (32767 - 3000) / 64;
+    if (tr == TREAT_DEEP && lp > 8192)                   /* SLOOP: s += (s - f) >> 2 */
+        lp = 8192;
+    if (tr == TREAT_DUST && lp > 16384)                  /* >> 1 */
+        lp = 16384;
+    if (tr == TREAT_TIGHT && dc > 32752)                 /* SLOOP: env -= env >> 11 */
+        dc = 32752;
+    for (; i < n; i++) {
+        int32_t s;
+        frac += stepq;
+        while (frac >= 65536u) {
+            frac -= 65536u;
+            v->s[2] = v->s[3];
+            if (v->ph[0] >= z->n) {                      /* the sample reached its end: the last interval fades to 0 */
+                v->s[4] |= HRV_END;
+                v->s[3] = 0;
+                if (frac >= 65536u) {
+                    v->s[2] = 0;
+                    frac &= 65535u;
+                }
+                break;
+            }
+            v->s[3] = hr_next(z, v);
+        }
+        s = v->s[2] + (((v->s[3] - v->s[2]) * (int32_t)(frac >> 1)) >> 15);
+        env = (env * dc) >> 15;
+        s = (s * env) >> 15;
+        if (lp < 32767) {
