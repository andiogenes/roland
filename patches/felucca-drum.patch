+        y[i] = s;
+        if (env <= 1 && dc < 32768)                      /* faded out (DECY, a choke) */
+            v->s[4] |= HRV_END;
+        if (v->s[4] & HRV_END) {
+            for (i++; i < n; i++)
+                y[i] = 0;
+            break;
+        }
+    }
+    v->s[6] = env;
+    v->ph[1] = frac;
+}
+#else
+#define HRV_ON 0
+#define HRV_END 0
+#endif
